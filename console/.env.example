SOC_API_URL=http://127.0.0.1:8000
SOC_DATABASE_URL=postgresql+psycopg://soc:soc@localhost:5434/soc
SOC_REDIS_URL=redis://localhost:6379/0
CONSOLE_SESSION_SECRET=dev-console-session

# Optional administrator MFA (staging only until migration 008 and CI/E2E pass).
# Setting SOC_ADMIN_TOTP_SECRET activates MFA automatically.
# Do not commit actual secrets; configure secrets in Vercel project settings.
SOC_REQUIRE_ADMIN_MFA=false
# SOC_ADMIN_TOTP_SECRET=<unique 160-bit-or-stronger Base32 secret>
# SOC_AUTH_DATABASE_URL=<restricted PostgreSQL role with replay-counter INSERT/UPDATE>
